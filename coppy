@app.route('/', methods=['GET'])
def index():
    # แสดงสถานะบอทที่หน้าหลักเซิร์ฟเวอร์เพื่อให้เข้ากันได้กับหน้าเว็บปัจจุบันของคุณ
    status = "Connected" if db else "Local-Memory Mode"
    return f"""
    <html>
        <head><title>5-Bot Teamwork Brain</title></head>
        <body style="font-family: sans-serif; text-align: center; padding-top: 50px; background-color: #f4f6f9;">
            <h1 style="color: #2c3e50;">🧠 Advanced AI Bot Brain is Online</h1>
            <p style="font-size: 1.2em; color: #7f8c8d;">ระบบสหายบอท 5 ส่วนทำงานร่วมกันอย่างเป็นระบบ</p>
            <div style="display: inline-block; padding: 10px 20px; background-color: #2ecc71; color: white; border-radius: 20px; font-weight: bold; margin-top: 20px;">
                Firebase Status: {status}
            </div>
        </body>
    </html>
    """

@app.route('/chat', methods=['POST'])
def chat_endpoint():
    data = request.get_json() or {}
    user_msg = data.get("message", "")
    session_id = data.get("session_id", "default_user")  # ใช้แยกเก็บความจำของผู้ใช้แต่ละคน
    
    if not user_msg:
        return jsonify({"error": "Missing message parameter"}), 400
        
    # สั่งให้ บอท 1 (ผู้ประสานงานหลัก) เริ่มประมวลผลข้อความและประสานงานบอทตัวอื่น
    bot_response = bot_1_chat_router(session_id, user_msg)
    
    return jsonify({
        "response": bot_response,
        "session_id": session_id
    })


if __name__ == '__main__':
    # รันเซิร์ฟเวอร์โดยรองรับพอร์ตที่ทาง Render กำหนดให้โดยอัตโนมัติ
    port = int(os.environ.get('PORT', 5000))
    app.run(host='0.0.0.0', port=port, debug=True)
